# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown next to the webhook you add on the sandbox app (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=

# Anthropic API key (console.anthropic.com), created for this project only
ANTHROPIC_API_KEY=
# Optional: override the model the agent uses (default claude-sonnet-5-5)
# AGENT_MODEL=

# Neon Postgres connection string
DATABASE_URL=

# Sandbox login for the demo buyer: a PayPal SANDBOX personal account (fake money). Shown on the buyer
# page; set the same two values on Render.
JUDGE_BUYER_EMAIL=
JUDGE_BUYER_PASSWORD=
# One PayPal sandbox login per demo buyer, as JSON keyed by the buyer's sandbox_key. Replaces the two
# lines above (they still work, as the buyer "morgan"). Example:
# SANDBOX_BUYERS={"morgan":{"email":"sb-...@personal.example.com","password":"..."},"recent":{...}}
SANDBOX_BUYERS=

# Secret for the scheduled recall sync (GitHub Actions sends it as a Bearer token). Set the same value
# on Render and as the GitHub repo secret CRON_SECRET. Generate with: openssl rand -hex 32
CRON_SECRET=
