# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown next to the webhook you add on the sandbox app (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=

# Anthropic API key (console.anthropic.com), created for this project only
ANTHROPIC_API_KEY=

# Neon Postgres connection string
DATABASE_URL=
