{
  "name": "recall-runner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "cpsc:fetch": "tsx scripts/fetch-cpsc.ts",
    "cpsc:ingest": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/ingest-recalls.ts",
    "db:rename-brands": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/rename-brands.ts",
    "db:seed": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/seed-demo.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:record": "tsx scripts/record-tests.ts",
    "paypal:attach": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/attach-captures.ts",
    "demo:money": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/demo-money.ts",
    "buyer:links": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/make-buyer-links.ts",
    "demo:sandbox-orders": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/add-sandbox-orders.ts",
    "demo:failure-drill": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/failure-drill.ts",
    "agent:run": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/run-agent.ts",
    "eval": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/run-evals.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
